---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = 'Empowering Claude — plugins and tools for Claude Code',
	description = 'Hand-made plugins and tools that make Claude Code better: marketplace plugins plus standalone tools like the Relevo multi-model orchestrator.',
	noindex = false,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/og-image.png', Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#14110f" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#faf6f0" media="(prefers-color-scheme: light)" />
		{noindex && <meta name="robots" content="noindex" />}
		<title>{title}</title>
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Empowering Claude" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Empowering Claude — plugins and tools for Claude Code" />
		<meta name="twitter:card" content="summary_large_image" />
		{ogImage && <meta name="twitter:image" content={ogImage} />}
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
		/>
	</head>
	<body>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-3 focus:py-2 focus:text-on-accent"
		>
			Skip to content
		</a>
		<slot />
	</body>
</html>
