---
import { MARKETPLACE_CMD, REPO_URL } from '../data/plugins';
import CopyCommand from './CopyCommand.astro';
---

<header class="relative isolate">
	<div
		class="pointer-events-none absolute inset-x-0 -top-24 -z-10 h-[520px] opacity-100"
		style="background: radial-gradient(60% 60% at 50% 0%, var(--glow), transparent 70%)"
		aria-hidden="true"
	>
	</div>
	<div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-5 sm:px-6">
		<a href="/" class="font-mono text-sm font-medium text-fg no-underline">
			<span class="text-accent" aria-hidden="true">&gt;</span> empowering-claude
		</a>
		<a
			href={REPO_URL}
			target="_blank"
			rel="noopener noreferrer"
			class="text-sm text-muted underline-offset-4 hover:text-fg hover:underline"
		>
			GitHub<span class="sr-only"> (opens in a new tab)</span>
		</a>
	</div>

	<div class="mx-auto max-w-5xl px-4 pt-14 pb-16 sm:px-6 sm:pt-24 sm:pb-24">
		<p class="m-0 font-mono text-sm text-accent">Claude Code plugins &amp; mods</p>
		<h1 class="mt-4 font-display text-5xl leading-[1.02] font-semibold tracking-tight sm:text-7xl">
			Empowering Claude<span class="hero-cursor ml-1 inline-block h-[0.8em] w-[0.38em] translate-y-[0.06em] bg-accent" aria-hidden="true"></span>
		</h1>
		<p class="mt-6 max-w-2xl text-lg text-muted sm:text-xl">
			Plugins and mods, made by hand, to make Claude Code better.
		</p>

		<div class="mt-10 max-w-2xl space-y-3">
			<p class="m-0 text-sm font-medium">Add the marketplace, once</p>
			<CopyCommand command={MARKETPLACE_CMD} label="Copy marketplace command" />
			<p class="m-0 text-sm text-muted">
				Run it inside Claude Code, then pick a plugin below.{' '}
				<a href="#plugins" class="text-accent underline underline-offset-4">Browse plugins</a>
			</p>
		</div>
	</div>
</header>

<style>
	.hero-cursor {
		animation: blink 1.1s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
</style>
