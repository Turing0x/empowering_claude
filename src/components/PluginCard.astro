---
import type { Item } from '../data/plugins';
import CopyCommand from './CopyCommand.astro';
import TerminalMock from './TerminalMock.astro';

interface Props {
	item: Item;
}

const { item } = Astro.props;
const install = item.install;

/** Splits text on `backticks` so inline code can be rendered as <code>. */
const parts = (text: string) => text.split('`').map((t, i) => ({ t, code: i % 2 === 1 }));
const linkClass =
	'inline-flex items-center gap-1.5 text-sm font-medium text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent';
---

<article
	id={item.slug}
	aria-labelledby={`${item.slug}-title`}
	class="scroll-mt-8 overflow-hidden rounded-2xl border border-line bg-surface"
>
	<div class="grid grid-cols-[minmax(0,1fr)] gap-8 p-5 sm:p-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-10 lg:p-10">
		<div class="flex min-w-0 flex-col">
			<div class="flex flex-wrap items-center gap-2 text-xs">
				<span class="rounded-full bg-accent px-2.5 py-1 font-semibold text-on-accent">{item.kind === 'toolkit' ? 'Toolkit' : 'Plugin'}</span>
				<span class="rounded-full border border-line bg-surface-2 px-2.5 py-1 font-mono text-muted">v{item.version}</span>
				{item.status && <span class="rounded-full border border-accent px-2.5 py-1 font-medium text-accent">{item.status}</span>}
				<span class="rounded-full border border-line px-2.5 py-1 text-muted">{item.category}</span>
				{item.license && <span class="rounded-full border border-line px-2.5 py-1 text-muted">{item.license}</span>}
			</div>
			<h3 id={`${item.slug}-title`} class="mt-4 font-display text-3xl font-semibold tracking-tight sm:text-4xl">
				{item.name}
			</h3>
			<p class="mt-1 text-lg text-accent">{item.tagline}</p>
			<p class="mt-4 text-muted">{item.description}</p>

			<ul class="mt-6 space-y-2.5 p-0">
				{
					item.features.map((f) => (
						<li class="flex list-none gap-3 text-sm">
							<svg viewBox="0 0 16 16" width="16" height="16" class="mt-0.5 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
								<path d="m3 8.5 3.2 3L13 4.5"></path>
							</svg>
							<span class="min-w-0 break-words">{f}</span>
						</li>
					))
				}
			</ul>

			{
				item.notice && (
					<p class="mt-6 min-w-0 break-words rounded-lg border border-line bg-surface-2 px-4 py-3 text-sm text-muted">
						<strong class="font-semibold text-fg">Heads up. </strong>{item.notice}
					</p>
				)
			}
		</div>

		<div class="flex min-w-0 flex-col gap-6">
			<div class="min-w-0">
				<TerminalMock mock={item.mock} />
				{item.mockCaption && <p class="m-0 mt-2 text-xs text-muted">{item.mockCaption}</p>}
			</div>
			<div class="min-w-0 space-y-3">
				<p class="m-0 text-sm font-medium">Install</p>

				{
					install.type === 'marketplace' && (
						<>
							<CopyCommand command={install.cmd} label={`Copy install command for ${item.name}`} />
							<p class="m-0 text-xs text-muted">Needs the marketplace added first (see below).</p>
						</>
					)
				}

				{
					install.type === 'script' && (
						<>
							{install.requirements && (
								<div>
									<p class="m-0 text-xs text-muted">Requirements</p>
									<ul class="m-0 mt-2 flex flex-wrap gap-2 p-0">
										{install.requirements.map((r) => (
											<li class="list-none rounded-full border border-line bg-surface-2 px-2.5 py-1 text-xs">{r}</li>
										))}
									</ul>
								</div>
							)}
							<ol class="m-0 space-y-3 p-0">
								{install.steps.map((s, i) => (
									<li class="flex min-w-0 list-none gap-3">
										<span class="mt-3 w-4 shrink-0 text-right font-mono text-xs text-muted" aria-hidden="true">{i + 1}</span>
										<div class="min-w-0 flex-1 space-y-1.5">
											<CopyCommand command={s.cmd} label={`Copy step ${i + 1}`} />
											{s.note && <p class="m-0 text-xs text-muted">{s.note}</p>}
										</div>
									</li>
								))}
							</ol>
							{install.after && (
								<ul class="m-0 space-y-1.5 p-0 pt-2 text-sm text-muted">
									{install.after.map((a) => (
										<li class="min-w-0 list-none break-words">
											{parts(a).map((p) => (p.code ? <code class="font-mono text-xs break-all text-fg">{p.t}</code> : p.t))}
										</li>
									))}
								</ul>
							)}
						</>
					)
				}

				<div class="flex flex-wrap gap-x-5 gap-y-2 pt-1">
					<a href={item.sourceUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
						View source on GitHub
						<span aria-hidden="true">↗</span>
						<span class="sr-only">(opens in a new tab)</span>
					</a>
					{
						item.docsUrl && (
							<a href={item.docsUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
								Read the docs
								<span aria-hidden="true">↗</span>
								<span class="sr-only">(opens in a new tab)</span>
							</a>
						)
					}
				</div>
			</div>
		</div>
	</div>
</article>
