---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — Empowering Claude" description="This page does not exist." noindex>
	<main id="main" class="mx-auto flex min-h-screen max-w-5xl flex-col justify-center px-4 py-16 sm:px-6">
		<p class="m-0 font-mono text-sm text-accent">404</p>
		<h1 class="mt-4 font-display text-5xl leading-[1.02] font-semibold tracking-tight sm:text-7xl">Page not found</h1>
		<p class="mt-6 max-w-xl text-lg text-muted">There is nothing at this address. The plugins and tools are on the home page.</p>
		<p class="mt-8 m-0">
			<a
				href="/"
				class="inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2.5 font-medium text-on-accent no-underline hover:opacity-90"
			>
				<span aria-hidden="true">←</span> Back to Empowering Claude
			</a>
		</p>
	</main>
</Layout>
