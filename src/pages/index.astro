---
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import InstallSteps from '../components/InstallSteps.astro';
import PluginCard from '../components/PluginCard.astro';
import { plugins } from '../data/plugins';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<Hero />
	<main id="main" class="mx-auto max-w-5xl space-y-24 px-4 pb-24 sm:px-6">
		<section id="plugins" aria-labelledby="plugins-title" class="scroll-mt-8">
			<h2 id="plugins-title" class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">Plugins</h2>
			<p class="mt-3 max-w-2xl text-muted">
				{plugins.length === 1 ? 'One plugin so far' : `${plugins.length} plugins`}, each small, focused and open source.
			</p>
			<div class="mt-8 space-y-8">
				{plugins.map((plugin) => <PluginCard plugin={plugin} />)}
			</div>
		</section>
		<InstallSteps />
	</main>
	<Footer />
</Layout>
