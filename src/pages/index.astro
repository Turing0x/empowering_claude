---
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import InstallSteps from '../components/InstallSteps.astro';
import PluginCard from '../components/PluginCard.astro';
import { items } from '../data/plugins';
import Layout from '../layouts/Layout.astro';

const pluginCount = items.filter((i) => i.kind === 'plugin').length;
const toolCount = items.filter((i) => i.kind === 'toolkit').length;
const count = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const summary = [
	pluginCount > 0 && count(pluginCount, 'plugin', 'plugins'),
	toolCount > 0 && count(toolCount, 'tool', 'tools'),
]
	.filter(Boolean)
	.join(' and ');
---

<Layout>
	<Hero />
	<main id="main" class="mx-auto max-w-5xl space-y-24 px-4 pb-24 sm:px-6">
		<section id="plugins" aria-labelledby="plugins-title" class="scroll-mt-8">
			<h2 id="plugins-title" class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">Plugins &amp; tools</h2>
			<p class="mt-3 max-w-2xl text-muted">
				{summary}, each focused and open source.
			</p>
			<div class="mt-8 space-y-8">
				{items.map((item) => <PluginCard item={item} />)}
			</div>
		</section>
		<InstallSteps />
	</main>
	<Footer />
</Layout>
